# Python build artifacts
*.egg-info/
build/
dist/
__pycache__/
*.pyc

# macOS filesystem artifacts
.DS_Store
**/.DS_Store
.AppleDouble
._*
Thumbs.db


# ForgeTool build artifacts
tools/libforge/**/bin/
tools/libforge/**/obj/

# Pi coding-agent workspace persistence (sessions/extensions/auth — auth.json
# holds SECRETS; only the README is ever committed). Managed by
# devscripts/setup_pi_persistence.sh.
.pi/*
!.pi/README.md

# C# build artifacts (devscripts/con_extract compiles from source with mcs)
*.exe
*.dll
obj/

# Local scratch/temp workspace
.tmp/
.coverage

# Generated user-facing release notes (regenerated by tools/gen_release_notes.py
# at build/release time; also bundled into the wheel/sdist by pyproject.toml)
RELEASE_NOTES.txt
output_ab/
.claude_persist

# Web UI job workspaces (uploads + per-job pipeline output); each job is a
# folder under webui_jobs/ holding its uploads, log, and output artifacts.
webui_jobs/

# Local (copyrighted) conversion test songs — NEVER commit; see
# tools/test_data/BENCHMARK_SONG.md
tools/test_data/local/*
!tools/test_data/local/.gitkeep
!tools/test_data/local/README.md

#available guitar tabs
tabs
