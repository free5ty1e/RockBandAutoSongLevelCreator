#!/bin/bash
# tools/forgetool
# Wrapper to run the built ForgeTool.exe with mono.
# Handles two layouts:
#   - Git clone / sdist: DLLs are in libforge/LibForge/ForgeTool/bin/Release/
#   - Flat layout: DLLs copied next to the wrapper in libforge/
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
TOOL_EXE=""
for candidate in \
  "$SCRIPT_DIR/libforge/ForgeTool.exe" \
  "$SCRIPT_DIR/libforge/LibForge/ForgeTool/bin/Release/ForgeTool.exe"; do
  if [ -f "$candidate" ]; then
    TOOL_EXE="$candidate"
    break
  fi
done
if [ -z "$TOOL_EXE" ]; then
  echo "ForgeTool.exe not found under $SCRIPT_DIR/libforge/." >&2
  echo "Run tools/build_forgetool.sh from a git clone to build it." >&2
  exit 1
fi

# macOS: mono 6.x does not search Homebrew's lib dirs for native dependencies
# (libgdiplus for System.Drawing, plus pango/cairo) by default, so ForgeTool
# fails with "DllNotFoundException: libgdiplus.dylib" even when installed.
# Add the Homebrew lib dir (Intel: /usr/local, Apple Silicon: /opt/homebrew) to
# the dynamic-library fallback path. Harmless on Linux (DYLD_* is ignored).
if [ "$(uname -s)" = "Darwin" ]; then
  if command -v brew >/dev/null 2>&1; then
    BREW_LIB="$(brew --prefix 2>/dev/null)/lib"
    if [ -n "$BREW_LIB" ] && [ -d "$BREW_LIB" ]; then
      export DYLD_FALLBACK_LIBRARY_PATH="$BREW_LIB${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}"
    fi
  fi
fi

exec mono "$TOOL_EXE" "$@"
